{
  "manifest_version": 3,
  "name": "Screen Sound Separation — Browser Support",
  "version": "0.3.0",
  "description": "Adds per-tab audio positioning to the Screen Sound Separation desktop app.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "alarms",
    "nativeMessaging",
    "offscreen",
    "system.display",
    "tabCapture"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Toggle audio separation for this tab",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
